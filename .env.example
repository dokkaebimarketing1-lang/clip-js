# Required in production for /api/agent/* and /api/render
CLIPJS_AGENT_TOKEN=replace-with-a-long-random-value
# Keep this separate from the agent token. Only the human owner/UI receives it.
CLIPJS_APPROVAL_TOKEN=replace-with-a-different-long-random-value
# Comma-separated exact hosts or wildcard subdomains. Configure the CDN hosts
# returned by Higgsfield. Example: cdn.example.com,*.cloudfront.net
CLIPJS_MEDIA_HOSTS=cdn.example.com
