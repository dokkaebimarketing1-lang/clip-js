# Required in production for /api/agent/* and render controls
CLIPJS_AGENT_TOKEN=replace-with-a-long-random-value
# Keep this separate from the agent token. Only the human owner/UI receives it.
CLIPJS_APPROVAL_TOKEN=replace-with-a-different-long-random-value
# Independent server-only HMAC key. Never send this value to a browser or API client.
CLIPJS_APPROVAL_SIGNING_SECRET=replace-with-a-third-high-entropy-server-only-value
CLIPJS_APPROVAL_SIGNING_KEY_ID=primary
CLIPJS_TRANSPORT_URL_ENCRYPTION_KEY=replace-with-a-fourth-high-entropy-server-only-value

# BytePlus ModelArk credentials are server-only. Never prefix these with NEXT_PUBLIC_.
BYTEPLUS_ARK_API_KEY=
# Planning LLM for one-sentence → brief/character/storyboard. Production is fail-closed
# unless explicitly configured. The model ID is pinned in the server implementation.
CLIPJS_PLANNING_PROVIDER=disabled
# Compile-only/fake-provider is the safe default. Enabling this alone is not sufficient:
# a current GenerationAuthorization and an atomic SubmissionClaim are also required.
BYTEPLUS_GENERATION_SUBMIT_ENABLED=false
CLIPJS_GENERATION_PROVIDER=disabled
BYTEPLUS_RESULT_HOSTS=
# Temporary local integration bridge only. Keep false by default. Setting this
# to true permits an owner-approved Higgsfield CLI POST that may spend credits.
CLIPJS_HIGGSFIELD_TEMP_SUBMIT_ENABLED=false
# Optional on Windows when the CLI is not discoverable from the server PATH.
# Point to higgsfield.cmd or @higgsfield/cli/bin/higgsfield.js.
HIGGSFIELD_CLI_PATH=
CLIPJS_GENERATION_REPOSITORY_DIR=.clipjs-runtime/generation
CLIPJS_GENERATED_ASSET_DIR=.clipjs-runtime/assets
CLIPJS_RENDER_JOB_DIR=.clipjs-runtime/render-jobs
CLIPJS_RENDER_OUTPUT_DIR=renders
CLIPJS_REMOTION_BUNDLE_DIR=remotion-bundle
REMOTION_BROWSER_EXECUTABLE_PATH=/path/to/chrome
CLIPJS_ASSET_CAPABILITY_SECRET=replace-with-another-long-random-value
CLIPJS_RENDER_DOWNLOAD_SECRET=replace-with-another-long-random-value

# Comma-separated exact hosts or wildcard subdomains used only for legacy remote media.
CLIPJS_MEDIA_HOSTS=cdn.example.com
